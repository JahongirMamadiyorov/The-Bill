{
  "name": "the-bill-pos",
  "productName": "The Bill POS",
  "version": "0.1.0",
  "description": "The Bill — Windows POS app (Admin, Owner, Cashier, Kitchen, New Waiter)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build:win": "npm run build:renderer && electron-builder --win",
    "pack": "npm run build:renderer && electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "7.0.3",
    "electron-updater": "6.1.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3",
    "electron": "28.3.3",
    "electron-builder": "24.9.1",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.thebill.pos",
    "productName": "The Bill POS",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "The Bill POS"
    },
    "publish": {
      "provider": "github",
      "owner": "jahongirmamadiyorov",
      "repo": "the-bill-pos"
    }
  }
}
